// ============================================================================
//  moontang.cst — MoonTANG sobre cartucho WonderTANG 2.0b / 2.02b
//                 Tang Nano 20K · GW2AR-LV18QN88C8/I7
// ----------------------------------------------------------------------------
//  Pinout COPIADO del top.cst oficial de lfantoniosi/WonderTANG (BSD-2), que es
//  el que corresponde a la placa 2.0b, con los nombres de señal de tnCart
//  (board_wt200b.cst de herraa1/tnCartWonder) porque el front-end de bus
//  vendorizado (WT200B_BUS) usa esa nomenclatura.
//
//  OJO: el netlist kicad del repo de WonderTANG esta OBSOLETO (habla de
//  Tang_Nano_9k y de un bus de direcciones SIN multiplexar). Las fuentes
//  buenas son top.cst y WonrderTANG.kicad_sch.
//
//  La SDRAM embebida NO se lista: sus pines son IMPLICITOS en la GW2AR-18.
//
//  Correspondencia con los nombres del repo oficial:
//    CART_DATA_SIG[7:0] = cd[7:0]      CART_MUX_SIG[7:0] = mp[7:0]
//    CART_MUX_CS_n[2]=msel_n[2]  CART_MUX_CS_n[1]=msel_n[0]  CART_MUX_CS_n[0]=msel_n[1]
//    CART_DATA_DIR = datadir
//
//  OJO, msel CRUZADO A PROPOSITO. En la placa (firmware oficial, top.v):
//      msel_n[0] (pin 17) a 0 -> mp = A0-A7
//      msel_n[1] (pin 20) a 0 -> mp = A8-A15
//      msel_n[2] (pin 19) a 0 -> mp = control (MERQ, IORQ, CS1, CS2, RESET, RFSH, CS12, M1)
//  El front-end de tnCart numera sus grupos AL REVES (su grupo 0 = A8-A15, su
//  grupo 1 = A0-A7; el propio README de tnCart lo avisa: "MSEL0 y MSEL1 parecen
//  estar al reves"), y herraa1 lo compensa en board_wt200b.cst cruzando los
//  pines. La primera version de este fichero (05/08/2026) asigno por NOMBRE
//  (CS_n[0]=17, CS_n[1]=20) y con eso el cartucho decodificaba A8-A15 como si
//  fuera el numero de puerto: no habria respondido en C4h-C7h ni 7Eh-7Fh.
//  Lo vigila tools/sim/tb_bus (modelo de placa por numero de pin).
//    DAC_DIN = hp_din   DAC_BCLK = hp_bck   DAC_LRCLK = hp_ws
//    DAC_SDMODE_n = pa_en (habilitacion del amplificador)
// ============================================================================

// ---- reloj de la placa ----
IO_LOC  "CLK_27M" 4;
IO_PORT "CLK_27M" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// ---- bus de datos del slot (74LVC245 dedicado) ----
IO_LOC  "CART_DATA_SIG[7]" 49;
IO_PORT "CART_DATA_SIG[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_DATA_SIG[6]" 53;
IO_PORT "CART_DATA_SIG[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_DATA_SIG[5]" 71;
IO_PORT "CART_DATA_SIG[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_DATA_SIG[4]" 72;
IO_PORT "CART_DATA_SIG[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_DATA_SIG[3]" 79;
IO_PORT "CART_DATA_SIG[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_DATA_SIG[2]" 86;
IO_PORT "CART_DATA_SIG[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_DATA_SIG[1]" 41;
IO_PORT "CART_DATA_SIG[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_DATA_SIG[0]" 48;
IO_PORT "CART_DATA_SIG[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- bus multiplexado: A0-A15 + control, por grupos ----
IO_LOC  "CART_MUX_SIG[7]" 31;
IO_PORT "CART_MUX_SIG[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_SIG[6]" 30;
IO_PORT "CART_MUX_SIG[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_SIG[5]" 29;
IO_PORT "CART_MUX_SIG[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_SIG[4]" 26;
IO_PORT "CART_MUX_SIG[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_SIG[3]" 25;
IO_PORT "CART_MUX_SIG[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_SIG[2]" 28;
IO_PORT "CART_MUX_SIG[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_SIG[1]" 27;
IO_PORT "CART_MUX_SIG[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_SIG[0]" 77;
IO_PORT "CART_MUX_SIG[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- seleccion de grupo del multiplexor ----
IO_LOC  "CART_MUX_CS_n[2]" 19;
IO_PORT "CART_MUX_CS_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_CS_n[1]" 17;
IO_PORT "CART_MUX_CS_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_MUX_CS_n[0]" 20;
IO_PORT "CART_MUX_CS_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- direccion del transceptor de datos ----
IO_LOC  "CART_DATA_DIR" 52;
IO_PORT "CART_DATA_DIR" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- control del slot ----
// wait_n e int_n pasan por 2N3904 INVERSORES -> PULL_MODE=DOWN para que no se
// autoafirmen durante la configuracion del FPGA. (La 2.0b no lleva pulldown en
// las bases: defecto conocido; ver checklist de bring-up.)
IO_LOC  "CART_WAIT_n" 42;
IO_PORT "CART_WAIT_n" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_INT_n" 73;
IO_PORT "CART_INT_n" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_BUSDIR_n" 74;
IO_PORT "CART_BUSDIR_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "CART_SLTSL_n" 18;
IO_PORT "CART_SLTSL_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_WR_n" 16;
IO_PORT "CART_WR_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_RD_n" 15;
IO_PORT "CART_RD_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "CART_CLOCK" 76;
IO_PORT "CART_CLOCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// ---- DAC I2S de la placa (hp_* + amplificador) ----
IO_LOC  "DAC_DIN" 54;
IO_PORT "DAC_DIN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "DAC_BCLK" 56;
IO_PORT "DAC_BCLK" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "DAC_LRCLK" 55;
IO_PORT "DAC_LRCLK" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "DAC_SDMODE_n" 51;
IO_PORT "DAC_SDMODE_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- flash SPI (imagen YRW801) ----
IO_LOC  "mspi_sclk" 59;
IO_PORT "mspi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mspi_cs" 60;
IO_PORT "mspi_cs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mspi_mosi" 61;
IO_PORT "mspi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "mspi_miso" 62;
IO_PORT "mspi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "mspi_hold" 63;
IO_PORT "mspi_hold" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- LED de diagnostico ----
IO_LOC  "LED" 75;
IO_PORT "LED" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- UART de telemetria (al BL616 USB-serie de la Tang Nano 20K) ----
// Pines del propio TN20K, no del carrier (tomados de board_wt200b.cst).
IO_LOC  "UART_TX" 69;
IO_PORT "UART_TX" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- HDMI (conector de la propia Tang Nano 20K) — solo en la variante con HDMI ----
// Mismos pines y tipo de E/S que el firmware oficial de la WonderTANG.
IO_LOC  "tmds_data_p[0]" 35,36;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "tmds_data_p[1]" 37,38;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "tmds_data_p[2]" 39,40;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
