localparam P_J2_8 = 79;   // zocalo ESP-01S, pad 8 (WIFI_TX)
// CON1.7 /WAIT: no llega a la FPGA (red "WAIT")
// CON1.8 ~{INT}: no llega a la FPGA (red "INT")
// CON1.9 M1: no llega a la FPGA (red "M1")
// CON1.10 ~{BUSDIR}: no llega a la FPGA (red "BUSDIR")
// CON1.49 SOUNDIN: no llega a la FPGA (red "unconnected-(CON1-Pad49)")
