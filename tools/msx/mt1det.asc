10 REM MoonTANG 1/6: deteccion del OPL4
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 DEF FNH$(X)=RIGHT$("0"+HEX$(X),2)
40 E=0:PRINT "MoonTANG 1/6 - deteccion OPL4"
50 PRINT "[1] Lectura en frio (sin escribir)"
60 A=INP(&HC4):B=INP(&HC5):C=INP(&HC6):D=INP(&HC7)
70 F=INP(&H7E):G=INP(&H7F)
80 PRINT " C4=";FNH$(A);" C5=";FNH$(B);" C6=";FNH$(C);" C7=";FNH$(D)
90 PRINT " 7E=";FNH$(F);" 7F=";FNH$(G)
100 PRINT " MoonTANG: 00 00 FF 00 / 00 00"
110 IF A=255 AND B=255 AND D=255 THEN PRINT " FALLO: C4-C7 leen FF":E=E+1:GOTO 900
120 IF (A AND &HE0)<>0 THEN PRINT " FALLO: flags de timer ya activos":E=E+1
130 PRINT "[2] FM: escribir y releer (C5/C7)"
140 OUT &HC6,5:OUT &HC7,1:OUT &HC6,5:N1=INP(&HC7)
150 PRINT " NEW=1 -> reg 105h = ";FNH$(N1);" (01)"
160 IF N1<>1 THEN PRINT " FALLO: NEW":E=E+1
170 RESTORE 1000:K=0
180 FOR I=1 TO 6:READ V
190 OUT &HC4,&HA6:OUT &HC5,V:OUT &HC6,&HA6:OUT &HC7,255-V
200 OUT &HC4,&HA6:X=INP(&HC5):OUT &HC6,&HA6:Y=INP(&HC7)
210 IF X<>V OR Y<>255-V THEN PRINT " ";FNH$(V);": lee ";FNH$(X);" ";FNH$(Y):K=K+1
220 NEXT I
230 OUT &HC4,&HA4:OUT &HC5,&H12:OUT &HC4,&HA5:OUT &HC5,&H34
240 OUT &HC4,&HA4:X=INP(&HC5):OUT &HC4,&HA5:Y=INP(&HC5)
250 IF X<>&H12 OR Y<>&H34 THEN PRINT " A4/A5 lee ";FNH$(X);" ";FNH$(Y):K=K+1
260 FOR R=&HA4 TO &HA6:OUT &HC4,R:OUT &HC5,0:OUT &HC6,R:OUT &HC7,0:NEXT R
270 IF K=0 THEN PRINT " relectura FM: OK (7 pruebas)" ELSE PRINT " FALLO: relectura FM";K:E=E+1
280 PRINT "[3] Wave: NEW2 e identificador"
290 OUT &HC6,5:OUT &HC7,3:OUT &HC6,5:N2=INP(&HC7)
300 S1=INP(&HC4):S2=INP(&HC4)
310 PRINT " NEW2=1 -> reg 105h = ";FNH$(N2);" (03)"
320 PRINT " status: ";FNH$(S1);" y luego ";FNH$(S2);" (00 o 02/00)"
330 IF N2<>3 THEN PRINT " FALLO: NEW2":E=E+1
340 IF (S2 AND &HE3)<>0 THEN PRINT " FALLO: el status no vuelve a 00":E=E+1
350 OUT &H7E,2:W=INP(&H7F)
360 PRINT " reg 02h = ";FNH$(W);" (20: ID 001xxxxx)"
370 IF (W AND &HE0)<>&H20 THEN PRINT " FALLO: no hay parte wave":PRINT " (LED parpadeando? esperar y repetir)":E=E+1
380 OUT &H7E,&H50:OUT &H7F,&HA4:OUT &H7E,&H51:OUT &H7F,&H4A
390 OUT &H7E,&H50:X=INP(&H7F):OUT &H7E,&H51:Y=INP(&H7F)
400 OUT &H7E,&H50:OUT &H7F,0:OUT &H7E,&H51:OUT &H7F,0
410 PRINT " TL 50h/51h = ";FNH$(X);" ";FNH$(Y);" (A4 4A)"
420 IF X<>&HA4 OR Y<>&H4A THEN PRINT " FALLO: relectura wave":E=E+1
430 OUT &H7E,&HF8:X=INP(&H7F):OUT &H7E,&HF9:Y=INP(&H7F)
440 PRINT " mezcla F8/F9 = ";FNH$(X);" ";FNH$(Y);" (info)"
900 PRINT
910 IF E=0 THEN PRINT "RESULTADO: OK, OPL4 detectado" ELSE PRINT "RESULTADO: FALLO,";E;"error(es)"
920 END
1000 DATA 0,255,85,170,15,240
