10 REM MoonTANG 4/6: lectura de la YRW801
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 DEF FNH$(X)=RIGHT$("0"+HEX$(X),2)
40 DIM D(255):E=0
50 PRINT "MoonTANG 4/6 - YRW801 por 02h-06h"
60 OUT &HC6,5:OUT &HC7,3:REM NEW2=1
70 OUT &H7E,2:OUT &H7F,1:REM modo acceso a memoria
80 OUT &H7E,2:M=INP(&H7F):PRINT "reg 02h = ";FNH$(M);" (21)"
90 IF M<>&H21 THEN PRINT " FALLO: modo memoria":E=E+1
100 PRINT "[1] Cabecera de la onda 0 (000000h):"
110 A=0:B=0:C=0:N=16:GOSUB 600
120 FOR I=0 TO 15:PRINT " ";FNH$(D(I));:IF I=7 THEN PRINT
130 NEXT I:PRINT
140 PRINT " esperado: 40 18 00 00 00 FF D6 00"
150 PRINT "           F0 00 0F 00 40 18 3F 00"
160 IF SU<>963 THEN PRINT " FALLO: suma";SU;"(963)":E=E+1
170 OUT &H7E,3:P3=INP(&H7F):OUT &H7E,4:P4=INP(&H7F):OUT &H7E,5:P5=INP(&H7F)
180 PRINT " puntero tras leer: ";FNH$(P3);FNH$(P4);FNH$(P5);"h (info)"
190 PRINT "[2] Texto en 001200h:"
200 A=0:B=&H12:C=0:N=15:GOSUB 600
210 T$="":FOR I=0 TO 14:V=D(I):IF V<32 OR V>126 THEN V=46
220 T$=T$+CHR$(V):NEXT I
230 PRINT " ";T$;" (CopyrightYAMAHA)"
240 IF T$<>"CopyrightYAMAHA" THEN PRINT " FALLO: texto":E=E+1
250 PRINT "[3] Version en 1FFFFEh:"
260 A=&H1F:B=&HFF:C=&HFE:N=2:GOSUB 600
270 PRINT " ";FNH$(D(0));" ";FNH$(D(1));" (01 00)"
280 IF D(0)<>1 OR D(1)<>0 THEN PRINT " FALLO: version":E=E+1
290 PRINT "[4] Sumas de 256 bytes:"
300 RESTORE 1000:FOR K=1 TO 4:READ A,B,X
310 C=0:N=256:GOSUB 600
320 PRINT " ";FNH$(A);FNH$(B);"00h:";SU;"(";X;")";
330 IF SU=X THEN PRINT "ok" ELSE PRINT "FALLO":E=E+1
340 NEXT K
350 OUT &H7E,2:OUT &H7F,0:REM vuelta al modo sonido
360 PRINT
370 IF E=0 THEN PRINT "RESULTADO: OK, YRW801 en su sitio" ELSE PRINT "RESULTADO: FALLO,";E;"error(es)"
380 END
600 OUT &H7E,3:OUT &H7F,A:OUT &H7E,4:OUT &H7F,B:OUT &H7E,5:OUT &H7F,C
610 OUT &H7E,6:SU=0:FOR I=0 TO N-1:D(I)=INP(&H7F):SU=SU+D(I):NEXT I
620 RETURN
1000 DATA 0,0,20524,10,170,34191,21,85,36174,31,255,25037
