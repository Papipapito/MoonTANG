10 REM MoonTANG 3/6: timers por sondeo (con DI)
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 CLEAR 200,&HBFFF
40 DEF FNH$(X)=RIGHT$("0"+HEX$(X),2)
50 PRINT "MoonTANG 3/6 - timers por sondeo"
60 AD=&HC000:SU=0:RESTORE 1000
70 READ A$:IF A$="*" THEN 90
80 V=VAL("&H"+A$):POKE AD,V:SU=SU+V:AD=AD+1:GOTO 70
90 IF SU<>13923 OR AD<>&HC062 THEN PRINT "Error en los DATA":END
100 DEFUSR=&HC000:E=0
110 PRINT "Bucle con DI (vueltas de 15,4 us)"
120 T$="T1=00h 20,48 ms":R=2:V=0:G=&H21:M=&H40:GOSUB 500:C1=C
130 T$="T1=C0h  5,12 ms":R=2:V=&HC0:G=&H21:M=&H40:GOSUB 500:C2=C
140 T$="T2=C0h 20,48 ms":R=3:V=&HC0:G=&H42:M=&H20:GOSUB 500:C3=C
150 IF C1=0 OR C2=0 OR C3=0 THEN 300
160 Q1=INT(100*C1/C2+.5)/100:Q2=INT(100*C3/C1+.5)/100
170 PRINT "T1 256/64 ticks =";Q1;"(4)"
180 PRINT "T2 / T1 (mismo tiempo) =";Q2;"(1)"
190 IF Q1<3.9 OR Q1>4.1 THEN PRINT " FALLO: tick del timer 1":E=E+1
200 IF Q2<.97 OR Q2>1.03 THEN PRINT " FALLO: tick del timer 2":E=E+1
210 IF ABS(C1-1333)>40 THEN PRINT " aviso: a 3,58 MHz T1=00h da ~1333"
300 PRINT
310 IF E=0 THEN PRINT "RESULTADO: OK, timers y flags" ELSE PRINT "RESULTADO: FALLO,";E;"error(es)"
320 END
500 POKE &HC0F0,V:POKE &HC0F1,R:POKE &HC0F2,G:POKE &HC0F3,M
510 X=USR(0)
520 C=PEEK(&HC0F8)+256*PEEK(&HC0F9)
530 S0=PEEK(&HC0F4):S1=PEEK(&HC0F5):S2=PEEK(&HC0F6)
540 PRINT T$;":";C;"vueltas"
550 PRINT "  status ";FNH$(S0);" -> ";FNH$(S1);" -> ";FNH$(S2)
560 IF C=0 THEN PRINT "  FALLO: el flag no sube":E=E+1:RETURN
570 IF (S0 AND &HE0)<>0 THEN PRINT "  FALLO: flags antes de empezar":E=E+1
580 IF (S1 AND &HE0)<>(128 OR M) THEN PRINT "  FALLO: status con el flag":E=E+1
590 IF (S2 AND &HE0)<>0 THEN PRINT "  FALLO: los flags no se limpian":E=E+1
600 RETURN
1000 DATA F3,3E,04,D3,C4,3E,60,D3,C5,3E,04,D3,C4,3E,80,D3
1010 DATA C5,06,20,10,FE,DB,C4,32,F4,C0,3A,F1,C0,D3,C4,3A
1020 DATA F0,C0,D3,C5,3E,04,D3,C4,3A,F2,C0,D3,C5,01,00,00
1030 DATA 3A,F3,C0,57,DB,C4,A2,20,05,03,78,B1,20,F6,ED,43
1040 DATA F8,C0,DB,C4,32,F5,C0,3E,04,D3,C4,3E,60,D3,C5,3E
1050 DATA 04,D3,C4,3E,80,D3,C5,06,20,10,FE,DB,C4,32,F6,C0
1060 DATA FB,C9
1070 DATA *
