10 REM MoonTANG 3b/6: IRQ del timer 1 (gancho H.KEYI)
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 CLEAR 200,&HBFFF
40 PRINT "MoonTANG 3b/6 - IRQ del timer 1"
50 IF PEEK(&HFD9A)=&HC3 AND PEEK(&HFD9B)=&H27 AND PEEK(&HFD9C)=&HC0 THEN DEFUSR1=&HC019:X=USR1(0)
60 AD=&HC000:SU=0:RESTORE 1000
70 READ A$:IF A$="*" THEN 90
80 V=VAL("&H"+A$):POKE AD,V:SU=SU+V:AD=AD+1:GOTO 70
90 IF SU<>8657 OR AD<>&HC041 THEN PRINT "Error en los DATA":END
100 DEFUSR0=&HC000:DEFUSR1=&HC019
110 F=60:IF PEEK(&H2B) AND 128 THEN F=50
120 PRINT "Antes, mt3tmr.asc: si alli los flags"
130 PRINT "no se limpian, esto colgaria el MSX."
140 PRINT "Una tecla para seguir, ESC sale":A$=INPUT$(1):IF A$=CHR$(27) THEN END
150 OUT &HC4,4:OUT &HC5,&H60:OUT &HC4,4:OUT &HC5,&H80
160 POKE &HC060,0:POKE &HC061,0
170 ON STOP GOSUB 750:STOP ON
180 X=USR0(0)
190 OUT &HC4,2:OUT &HC5,&H83:REM 125 ticks = 10 ms
200 OUT &HC4,4:OUT &HC5,&H21:TIME=0
210 IF TIME<3*F THEN 210
220 N=PEEK(&HC060)+256*PEEK(&HC061):S=INP(&HC4)
230 GOSUB 700
240 PRINT "Timer 1 cada 10 ms durante 3 s"
250 PRINT "IRQ contadas:";N;"(300)  VDP";F;"Hz"
260 IF N>=294 AND N<=306 THEN PRINT "RESULTADO: OK, /INT funciona":END
270 IF N=0 AND (S AND &HC0)=&HC0 THEN PRINT "El timer va pero /INT no llega":PRINT "(normal en la SMD: no tiene /INT)"
280 PRINT "RESULTADO: FALLO"
290 END
700 OUT &HC4,4:OUT &HC5,&H60:OUT &HC4,4:OUT &HC5,&H80
710 X=USR1(0):STOP OFF:RETURN
750 GOSUB 700:PRINT "Interrumpido":END
1000 DATA F3,21,9A,FD,11,3C,C0,01,05,00,ED,B0,3E,C3,32,9A
1010 DATA FD,21,27,C0,22,9B,FD,FB,C9,F3,21,3C,C0,11,9A,FD
1020 DATA 01,05,00,ED,B0,FB,C9,DB,C4,E6,80,28,0F,2A,60,C0
1030 DATA 23,22,60,C0,3E,04,D3,C4,3E,80,D3,C5,C9,C9,C9,C9
1040 DATA C9
1050 DATA *
