10 REM MoonTANG 6/6: nota PCM con la YRW801
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 DEF FNH$(X)=RIGHT$("0"+HEX$(X),2)
40 F=60:IF PEEK(&H2B) AND 128 THEN F=50
50 E=0:PRINT "MoonTANG 6/6 - nota PCM (wavetable)"
60 OUT &HC6,5:OUT &HC7,3:REM NEW2=1
70 OUT &H7E,2:OUT &H7F,0:REM modo sonido
80 OUT &H7E,&HF9:OUT &H7F,0:REM PCM a 0 dB
90 OUT &H7E,&H68:OUT &H7F,0:REM slot 0 apagado
100 PRINT "[1] Onda 0 (seno), 262 Hz, 2 s"
110 W=0:R0=0:R8=&HF0:GOSUB 600
120 RESTORE 1000:GOSUB 700
130 GOSUB 800:TIME=0
140 IF TIME<2*F THEN 140
150 OUT &H7E,&H68:OUT &H7F,0
160 PRINT " Un tono limpio y continuo? (S/N)":GOSUB 900
170 PRINT "[2] Piano GM 0 (onda 130h), DO4, 3 s"
180 W=&H30:R0=&HAD:R8=&HF5:GOSUB 600
190 RESTORE 1010:GOSUB 700
200 GOSUB 800:TIME=0
210 IF TIME<3*F THEN 210
220 OUT &H7E,&H68:OUT &H7F,0
230 PRINT " Una nota de piano? (S/N)":GOSUB 900
240 PRINT
250 IF E=0 THEN PRINT "RESULTADO: OK, la wavetable suena" ELSE PRINT "RESULTADO: FALLO,";E;"error(es)"
260 END
600 OUT &H7E,&H20:OUT &H7F,R0:OUT &H7E,&H38:OUT &H7F,R8
610 OUT &H7E,8:OUT &H7F,W:L=0
620 L=L+1:IF (INP(&HC4) AND 2)<>0 AND L<500 THEN 620
630 PRINT " status leido";L;"vez/veces hasta LD=0"
640 IF L>=500 THEN PRINT " FALLO: LD no baja":E=E+1
650 RETURN
700 PRINT " leido   :";:X=0:FOR I=0 TO 4:READ H(I):OUT &H7E,&H80+24*I:Y=INP(&H7F):PRINT " ";FNH$(Y);:IF Y<>H(I) THEN X=X+1
710 NEXT I:PRINT
720 PRINT " esperado:";:FOR I=0 TO 4:PRINT " ";FNH$(H(I));:NEXT I:PRINT
730 IF X>0 THEN PRINT " FALLO: cabecera no cargada":E=E+1
740 RETURN
800 OUT &H7E,&H50:OUT &H7F,0:OUT &H7E,&H68:OUT &H7F,&H80:RETURN
900 A$=INPUT$(1):IF A$="S" OR A$="s" THEN PRINT " -> si":RETURN
910 PRINT " -> no":E=E+1:RETURN
1000 DATA 0,240,0,15,0
1010 DATA 0,242,20,8,0
