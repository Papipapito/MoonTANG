10 REM MoonTANG 7: MSX-Audio (Y8950) en C0h-C1h
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 CLEAR 200,&HBFFF:DEFINT A-Z:DEFSNG C,Q
40 DEF FNH$(X)=RIGHT$("0"+HEX$(X),2)
50 F=60:IF PEEK(&H2B) AND 128 THEN F=50
60 PRINT "MoonTANG 7 - MSX-Audio (Y8950)"
70 AD=&HC000:SU=0:RESTORE 2000:GOSUB 1520:IF SU<>13277 OR AD<>&HC062 THEN 1510
80 AD=&HC100:SU=0:RESTORE 2100:GOSUB 1520:IF SU<>29231 OR AD<>&HC200 THEN 1510
90 DEFUSR=&HC000:E=0:F$="":ON STOP GOSUB 1500:STOP ON
100 SN=1:PRINT "[1] Deteccion: status de C0h"
110 S0=INP(&HC0)
120 OUT &HC0,4:OUT &HC1,&H78:OUT &HC0,4:OUT &HC1,&H80:OUT &HC0,7:OUT &HC1,1
130 S1=INP(&HC0):PRINT " ";FNH$(S0);" al entrar, ";FNH$(S1);" tras parar (06)"
140 IF S1=255 THEN PRINT " FALLO: C0h lee FF, no hay MSX-Audio":PRINT " (es el bitstream WT normal?)":GOSUB 1420:GOTO 1100
150 IF (S1 OR 6)<>6 THEN PRINT " FALLO: eso no es un Y8950":GOSUB 1420:GOTO 1100
160 IF S1<>6 THEN PRINT " FALLO: los bits 1 y 2 deben ser 1":GOSUB 1420
200 SN=2:PRINT "[2] Timers por sondeo (con DI)"
210 T$="T1=00h 20,6 ms":R=2:V=0:G=&H39:M=&H40:GOSUB 1200:C1=C
220 T$="T1=C0h  5,1 ms":R=2:V=&HC0:G=&H39:M=&H40:GOSUB 1200:C2=C
230 T$="T2=C0h 20,6 ms":R=3:V=&HC0:G=&H5A:M=&H20:GOSUB 1200:C3=C
240 IF C1=0 OR C2=0 OR C3=0 THEN 300
250 Q1=INT(100*C1/C2+.5)/100:Q2=INT(100*C3/C1+.5)/100
260 PRINT " T1 256/64 ticks =";Q1;"(4)"
270 PRINT " T2 / T1 (mismo tiempo) =";Q2;"(1)"
280 IF Q1<3.9 OR Q1>4.1 THEN PRINT " FALLO: tick del timer 1":GOSUB 1420
290 IF Q2<.97 OR Q2>1.03 THEN PRINT " FALLO: tick del timer 2":GOSUB 1420
295 IF ABS(C1-1340)>40 THEN PRINT " aviso: a 3,58 MHz T1=00h da ~1340"
300 SN=3:PRINT "[3] Nota FM: LA 440 Hz, 2 s"
310 OUT &HC0,1:OUT &HC1,0:OUT &HC0,8:OUT &HC1,0:OUT &HC0,&HBD:OUT &HC1,0
320 FOR I=0 TO 8:OUT &HC0,&HB0+I:OUT &HC1,0:NEXT I
330 RESTORE 2300:FOR I=1 TO 9:READ R,V:OUT &HC0,R:OUT &HC1,V:NEXT I
340 OUT &HC0,&HA0:OUT &HC1,&H44:OUT &HC0,&HB0:OUT &HC1,&H32:TIME=0
350 IF TIME<2*F THEN 350
360 OUT &HC0,&HB0:OUT &HC1,&H12
370 PRINT " La has oido? (S/N)":GOSUB 1400
400 SN=4:PRINT "[4] OPL4: foto de su memoria"
410 IF INP(&HC4)=255 THEN PRINT " FALLO: no hay OPL4 en C4h":GOSUB 1420:GOTO 500
420 OUT &HC6,5:OUT &HC7,3:OUT &H7E,2:OUT &H7F,1
430 P=0:GOSUB 1340:H1=SU:P=&H20:GOSUB 1350
440 FOR I=0 TO 15:OUT &H7F,I*15+7:NEXT I:OUT &H7E,2:OUT &H7F,0
450 PRINT " ROM 000000h: suma";H1;"(963: YRW801)"
500 SN=5:PRINT "[5] ADPCM: subir y releer 256 bytes"
510 OUT &HC0,7:OUT &HC1,1:OUT &HC0,8:OUT &HC1,0
520 A=0:B=0:Y=&H3F:Z=0:GOSUB 1300:GOSUB 1310
530 FOR I=0 TO 255:OUT &HC1,PEEK(&HC100+I):NEXT I
540 GOSUB 1320:K=0
550 FOR I=0 TO 255:V=INP(&HC1):IF V<>PEEK(&HC100+I) THEN K=K+1:IF K=1 THEN PRINT " 1er fallo en +";FNH$(I);": ";FNH$(V)
560 NEXT I:OUT &HC0,7:OUT &HC1,1
570 IF K=0 THEN PRINT " 256 bytes OK" ELSE PRINT " FALLO:";K;"bytes mal":GOSUB 1420
600 SN=6:PRINT "[6] ADPCM: una pasada hasta EOS"
610 OUT &HC0,&H10:OUT &HC1,&H81:OUT &HC0,&H11:OUT &HC1,&H48:OUT &HC0,&H12:OUT &HC1,255
620 T$="512 nibbles a 14,1 kHz":R=7:V=&HA0:G=&H68:M=16:GOSUB 1200:C4=C:OUT &HC0,7:OUT &HC1,1
630 IF C4>0 AND C1>0 THEN Q3=INT(1000*C4/C1+.5)/1000:PRINT " duracion / T1 =";Q3;"(1.765)":IF Q3<1.71 OR Q3>1.82 THEN PRINT " FALLO: velocidad del ADPCM":GOSUB 1420
700 SN=7:PRINT "[7] Pitido ADPCM: LA 880 Hz, 2 s"
710 OUT &HC0,7:OUT &HC1,&HB0:TIME=0
720 IF TIME<2*F THEN 720
730 OUT &HC0,7:OUT &HC1,1
740 PRINT " Lo has oido? (S/N)":GOSUB 1400
800 SN=8:PRINT "[8] RAM ADPCM: una marca cada 32 KB"
810 FOR K=0 TO 7:GOSUB 1330:GOSUB 1310:FOR I=0 TO 3:OUT &HC1,(K*15+I*85+15) AND 255:NEXT I,K
820 N=0:FOR K=0 TO 7:GOSUB 1330:GOSUB 1320:W=0
830 FOR I=0 TO 3:IF INP(&HC1)=((K*15+I*85+15) AND 255) THEN W=W+1
840 NEXT I:IF W=4 THEN N=N+1
850 NEXT K:OUT &HC0,7:OUT &HC1,1
860 PRINT " marcas que vuelven:";N;"de 8 =";N*32;"KB"
870 IF N<8 THEN PRINT " FALLO: MoonTANG tiene 256 KB":GOSUB 1420
900 SN=9:PRINT "[9] Convivencia con el OPL4"
910 IF INP(&HC4)=255 THEN PRINT " FALLO: no hay OPL4 en C4h":GOSUB 1420:GOTO 1060
920 OUT &H7E,2:OUT &H7F,1:P=0:GOSUB 1340:H2=SU:P=&H20:GOSUB 1350:K=0
930 FOR I=0 TO 15:IF INP(&H7F)<>I*15+7 THEN K=K+1
940 NEXT I:PRINT " ROM 000000h: suma";H2;"(";H1;")"
950 PRINT " RAM 200000h:";16-K;"de 16 bytes intactos"
960 IF H2<>H1 OR K>0 THEN PRINT " FALLO: el ADPCM pisa la memoria":PRINT " del OPL4":GOSUB 1420
970 GOSUB 1350:FOR I=0 TO 15:OUT &H7F,255-I*15:NEXT I:OUT &H7E,2:OUT &H7F,0
980 A=0:B=0:Y=&H3F:Z=0:GOSUB 1300:GOSUB 1320:K=0:FOR I=0 TO 255:IF INP(&HC1)<>PEEK(&HC100+I) THEN K=K+1
990 NEXT I:OUT &HC0,7:OUT &HC1,1:IF K>0 THEN PRINT " FALLO: el OPL4 pisa la RAM ADPCM":GOSUB 1420
1000 OUT &HC4,&HA5:OUT &HC5,&H5A:OUT &HC0,&HA5:OUT &HC1,&HA5:OUT &HC4,&HA5:X=INP(&HC5)
1010 OUT &HC4,&HA5:OUT &HC5,0:OUT &HC0,&HA5:OUT &HC1,0:S=INP(&HC0):T=INP(&HC4)
1020 PRINT " reg A5h del OPL4: ";FNH$(X);" (5A)"
1030 PRINT " status C0h y C4h: ";FNH$(S);" ";FNH$(T);" (06 00)"
1040 IF X<>&H5A THEN PRINT " FALLO: el Y8950 escribe en el OPL4":GOSUB 1420
1050 IF S<>6 OR (T AND &HE0)<>0 THEN PRINT " FALLO: status cruzados":GOSUB 1420
1060 OUT &HC0,7:OUT &HC1,1:OUT &HC0,4:OUT &HC1,&H78:OUT &HC0,4:OUT &HC1,&H80
1100 PRINT
1110 IF E=0 THEN PRINT "RESULTADO: OK, MSX-Audio completo" ELSE PRINT "RESULTADO: FALLO,";E;"error(es)":PRINT " en las pruebas";F$
1120 END
1200 POKE &HC0F0,V:POKE &HC0F1,R:POKE &HC0F2,G:POKE &HC0F3,M
1210 X=USR(0):C=PEEK(&HC0F8)+256!*PEEK(&HC0F9)
1220 S0=PEEK(&HC0F4):S1=PEEK(&HC0F5):S2=PEEK(&HC0F6)
1230 PRINT " ";T$;":";C;"vueltas"
1240 PRINT "  status ";FNH$(S0);" -> ";FNH$(S1);" -> ";FNH$(S2)
1250 IF C=0 THEN PRINT "  FALLO: el flag no sube":GOSUB 1420:RETURN
1260 IF (S0 AND &HF8)<>0 THEN PRINT "  FALLO: flags antes de empezar":GOSUB 1420
1270 IF (S1 AND &HF8)<>(128 OR M) THEN PRINT "  FALLO: status con el flag":GOSUB 1420
1280 IF (S2 AND &HF8)<>0 THEN PRINT "  FALLO: los flags no se limpian":GOSUB 1420
1290 RETURN
1300 OUT &HC0,9:OUT &HC1,A:OUT &HC0,10:OUT &HC1,B:OUT &HC0,11:OUT &HC1,Y:OUT &HC0,12:OUT &HC1,Z:RETURN
1310 OUT &HC0,7:OUT &HC1,1:OUT &HC0,7:OUT &HC1,&H60:OUT &HC0,&HF:RETURN
1320 OUT &HC0,7:OUT &HC1,1:OUT &HC0,7:OUT &HC1,&H20:OUT &HC0,&HF:X=INP(&HC1):X=INP(&HC1):RETURN
1330 A=255:B=K*32+31:Y=A:Z=B:GOTO 1300
1340 GOSUB 1350:SU=0:FOR I=0 TO 15:SU=SU+INP(&H7F):NEXT I:RETURN
1350 OUT &H7E,3:OUT &H7F,P:OUT &H7E,4:OUT &H7F,0:OUT &H7E,5:OUT &H7F,0:OUT &H7E,6:RETURN
1400 A$=INPUT$(1):IF A$="S" OR A$="s" THEN PRINT " -> si":RETURN
1410 PRINT " -> no":GOSUB 1420:RETURN
1420 E=E+1:IF INSTR(F$,STR$(SN))=0 THEN F$=F$+STR$(SN)
1430 RETURN
1500 OUT &HC0,7:OUT &HC1,1:OUT &HC0,&HB0:OUT &HC1,0:PRINT "Interrumpido":END
1510 PRINT "Error en los DATA":END
1520 READ A$:IF A$="*" THEN RETURN
1530 V=VAL("&H"+A$):POKE AD,V:SU=SU+V:AD=AD+1:GOTO 1520
2000 DATA F3,3E,04,1E,78,CD,56,C0,3E,04,1E,80,CD,56,C0,DB
2010 DATA C0,32,F4,C0,3A,F0,C0,5F,3A,F1,C0,CD,56,C0,3A,F2
2020 DATA C0,5F,3E,04,CD,56,C0,01,00,00,3A,F3,C0,57,DB,C0
2030 DATA A2,20,05,03,78,B1,20,F6,ED,43,F8,C0,DB,C0,32,F5
2040 DATA C0,3E,04,1E,78,CD,56,C0,3E,04,1E,80,CD,56,C0,DB
2050 DATA C0,32,F6,C0,FB,C9,D3,C0,E3,E3,7B,D3,C1,06,07,10
2060 DATA FE,C9
2070 DATA *
2100 DATA 77,77,78,AB,BB,A8,13,54,33,21,9B,EB,CA,A8,03,53
2110 DATA 42,21,9B,CD,BB,99,12,63,33,21,9B,EB,CB,99,12,54
2120 DATA 23,20,8B,DC,BA,A9,13,54,33,20,8B,EB,CA,A8,12,53
2130 DATA 42,20,8B,CD,BA,A9,13,53,43,21,9B,DC,BB,A9,13,63
2140 DATA 42,20,9A,DB,CA,A8,03,53,43,11,9A,EB,BB,A8,13,54
2150 DATA 42,11,9A,CD,AB,98,02,53,42,21,9B,CD,BA,A8,03,53
2160 DATA 52,10,8A,CC,BB,A8,03,63,42,20,9A,DB,CA,A8,03,53
2170 DATA 43,11,9A,DC,BA,A9,13,54,32,30,9B,DC,BB,A9,13,63
2180 DATA 42,20,8B,DB,CB,99,13,53,43,20,8B,DC,BB,A8,03,63
2190 DATA 34,11,9A,DB,CA,A8,03,53,43,11,9B,CD,BB,A8,13,54
2200 DATA 32,21,9B,DC,BB,A9,13,63,42,20,8B,DB,CA,A9,13,45
2210 DATA 33,11,9A,EB,BB,A9,13,63,43,11,9A,DC,AB,A8,03,54
2220 DATA 32,21,9B,DC,BB,A8,03,63,42,20,9A,DB,CA,A8,03,53
2230 DATA 43,11,9A,DC,BB,99,13,54,33,20,8C,CC,BB,A8,03,63
2240 DATA 42,20,8B,CD,BA,A8,03,53,52,10,8A,CC,BB,A8,13,54
2250 DATA 33,21,9B,EB,CA,A8,03,45,32,20,8B,DB,CB,A8,03,54
2260 DATA *
2300 DATA 32,33,64,63,96,240,128,15,35,33,67,0,99,240,131,5,192,0
