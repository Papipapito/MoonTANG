10 REM MoonTANG 5/6: RAM de muestras
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 DEF FNH$(X)=RIGHT$("0"+HEX$(X),2)
40 E=0:PRINT "MoonTANG 5/6 - RAM de muestras"
50 OUT &HC6,5:OUT &HC7,3:REM NEW2=1
60 OUT &H7E,2:OUT &H7F,1:REM modo acceso a memoria
70 PRINT "[1] 256 bytes en 200000h"
80 A=&H20:B=0:K=7:Q=3:GOSUB 600
90 PRINT "[2] 256 bytes en 3FFF00h (fin de 2 MB)"
100 A=&H3F:B=&HFF:K=13:Q=5:GOSUB 600
110 PRINT "[3] Tamano: una marca cada 128 KB"
120 FOR K=0 TO 15:GOSUB 700:OUT &H7F,K*16+15-K:NEXT K
130 Z=0:FOR K=0 TO 15:GOSUB 700:V=INP(&H7F):IF V=K*16+15-K THEN Z=Z+1
140 NEXT K
150 PRINT " marcas que vuelven:";Z;"de 16 =";Z*128;"KB"
160 IF Z<16 THEN PRINT " FALLO: MoonTANG tiene 2048 KB":E=E+1
170 PRINT "[4] La ROM no se escribe"
180 A=0:B=0:GOSUB 710:OUT &H7F,0:GOSUB 710:V=INP(&H7F)
190 PRINT " 000000h tras escribir 00: ";FNH$(V);" (40)"
200 IF V<>&H40 THEN PRINT " FALLO: la ROM ha cambiado":E=E+1
210 PRINT "[5] 06h fuera del modo memoria (info)"
220 A=&H20:B=0:GOSUB 710:OUT &H7F,&H11:OUT &H7F,&H22
230 OUT &H7E,2:OUT &H7F,0:GOSUB 710:OUT &H7F,&H77:X=INP(&H7F)
240 OUT &H7E,2:OUT &H7F,1:GOSUB 710:Y=INP(&H7F):Z=INP(&H7F)
250 PRINT " lee ";FNH$(X);"; RAM 200000h = ";FNH$(Y);" ";FNH$(Z)
260 PRINT " openMSX: FF; 11 22 / MAME: 77; 11 22"
270 IF Z<>&H22 THEN PRINT " desviacion (MoonTANG: 77; 11 77):":PRINT " la escritura llego a la RAM; info"
280 OUT &H7E,2:OUT &H7F,0:REM vuelta al modo sonido
290 PRINT
300 IF E=0 THEN PRINT "RESULTADO: OK, RAM de 2 MB bien" ELSE PRINT "RESULTADO: FALLO,";E;"error(es)"
310 END
600 GOSUB 710:FOR I=0 TO 255:OUT &H7F,(I*K+Q) AND 255:NEXT I
610 GOSUB 710:X=0:FOR I=0 TO 255:V=INP(&H7F):IF V<>((I*K+Q) AND 255) THEN X=X+1:IF X=1 THEN PRINT " 1er fallo en +";FNH$(I);": ";FNH$(V)
620 NEXT I
630 IF X=0 THEN PRINT " 256 bytes OK" ELSE PRINT " FALLO:";X;"bytes mal":E=E+1
640 RETURN
700 A=&H20+2*K:B=0
710 OUT &H7E,3:OUT &H7F,A:OUT &H7E,4:OUT &H7F,B:OUT &H7E,5:OUT &H7F,0:OUT &H7E,6:RETURN
