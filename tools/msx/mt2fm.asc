10 REM MoonTANG 2/6: tono FM y escala
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 F=60:IF PEEK(&H2B) AND 128 THEN F=50
40 E=0:PRINT "MoonTANG 2/6 - FM (OPL3)"
50 OUT &HC6,5:OUT &HC7,3:REM NEW=1 y NEW2=1
60 FOR I=0 TO 8:OUT &HC4,&HB0+I:OUT &HC5,0:OUT &HC6,&HB0+I:OUT &HC7,0:NEXT I
70 OUT &HC4,&HBD:OUT &HC5,0
80 RESTORE 1000:FOR I=1 TO 11:READ R,V:OUT &HC4,R:OUT &HC5,V:NEXT I
90 PRINT "[1] Seno puro, LA 440 Hz, 2 s"
100 OUT &HC4,&HA0:OUT &HC5,&H46:OUT &HC4,&HB0:OUT &HC5,&H32
110 TIME=0
120 IF TIME<2*F THEN 120
130 OUT &HC4,&HB0:OUT &HC5,&H12
140 PRINT " Lo has oido? (S/N)":GOSUB 2000
150 PRINT "[2] Escala DO4-DO5 (voz FM)"
160 OUT &HC4,&H40:OUT &HC5,&H1C
170 RESTORE 1100
180 FOR I=1 TO 8:READ N:L=N AND 255:H=(N\256) OR 16
190 OUT &HC4,&HA0:OUT &HC5,L:OUT &HC4,&HB0:OUT &HC5,H OR 32
200 TIME=0
210 IF TIME<F\3 THEN 210
220 OUT &HC4,&HB0:OUT &HC5,H
230 TIME=0
240 IF TIME<F\15 THEN 240
250 NEXT I
260 PRINT " Ocho notas subiendo? (S/N)":GOSUB 2000
270 PRINT "[3] Panorama (solo con HDMI estereo)"
280 OUT &HC4,&H40:OUT &HC5,&H3F
290 FOR P=1 TO 2:OUT &HC4,&HC0:OUT &HC5,16*P
300 OUT &HC4,&HA0:OUT &HC5,&H46:OUT &HC4,&HB0:OUT &HC5,&H32
310 TIME=0
320 IF TIME<F THEN 320
330 OUT &HC4,&HB0:OUT &HC5,&H12
340 TIME=0
350 IF TIME<F\2 THEN 350
360 NEXT P
370 OUT &HC4,&HC0:OUT &HC5,&H30
380 PRINT " izquierda y luego derecha; en mono"
390 PRINT " (WonderTANG) suenan igual. Info."
400 PRINT
410 IF E=0 THEN PRINT "RESULTADO: OK, el FM suena" ELSE PRINT "RESULTADO: FALLO,";E;"prueba(s) sin sonido"
420 END
1000 DATA 32,33,64,63,96,240,128,15,224,0
1010 DATA 35,33,67,0,99,240,131,5,227,0,192,48
1100 DATA 346,389,436,462,519,582,654,693
2000 A$=INPUT$(1):IF A$="S" OR A$="s" THEN PRINT " -> si":RETURN
2010 PRINT " -> no":E=E+1:RETURN
